// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum QUYEN {
  ADMIN
  USER
}

enum GIOI_TINH {
  NAM
  NU
  KHAC
}

enum TRANG_THAI_LAM_VIEC {
  DANG_LAM_VIEC
  THU_VIEC
  NGHI_VIEC
}

enum HINH_THUC_LAM_VIEC {
  TOAN_THOI_GIAN
  BAN_THOI_GIAN
  THU_VIEC
}

enum CHUC_VU {
  NHAN_VIEN_KINH_DOANH
  TRUONG_PHONG_KINH_DOANH
  PHO_CHU_TICH
  NHAN_VIEN
}

enum PHONGBAN {
  BAN_GIAM_DOC
  PHONG_KINH_DOANH
}

enum LOAI_NHOM_KH {
  KHACH_LE
  DAI_LY
}

enum PHAN_LOAI_CSKH {
  CHUA_THAM_DINH
  KHACH_TIEM_NANG
  KHONG_PHU_HOP
}

model NGUOI_DUNG {
  ID_NGUOI_DUNG String @id @default(auto()) @map("_id") @db.ObjectId
  TAI_KHOAN     String @unique
  MAT_KHAU      String
  QUYEN         QUYEN @default(USER)
}

model NHAN_VIEN {
  ID_NHAN_VIEN String @id @default(auto()) @map("_id") @db.ObjectId
  MA_NV        String @unique
  HO_VA_TEN    String

  GIOI_TINH          GIOI_TINH
  NGAY_SINH          DateTime
  SO_DIEN_THOAI      String
  EMAIL              String
  DIA_CHI_THUONG_TRU String
  DIA_CHI_HIEN_TAI   String
  HINH_ANH           String?
  VECTOR_ANH         Float[]   @default([])

  SO_CCCD           String?
  NGAY_CAP_CCCD     DateTime?
  NOI_CAP_CCCD      String?
  NGAY_HET_HAN_CCCD DateTime?
  MA_SO_THUE        String?
  SO_BHXH           String?
  SO_BHYT           String?

  TRANG_THAI      TRANG_THAI_LAM_VIEC @default(DANG_LAM_VIEC)
  HINH_THUC       HINH_THUC_LAM_VIEC  @default(TOAN_THOI_GIAN)
  CHUC_VU         CHUC_VU?
  PHONGBAN        PHONGBAN?
  USER_NAME       String?  @unique
  PASSWORD        String?
  NGAY_THU_VIEC   DateTime?
  NGAY_CHINH_THUC DateTime?
  NGAY_NGHI_VIEC  DateTime?

  @@index([HO_VA_TEN])
  @@index([EMAIL])
  @@index([PHONGBAN])
}

model NHOM_KH {
  ID_NHOM String       @id @default(auto()) @map("_id") @db.ObjectId
  NHOM    LOAI_NHOM_KH @unique

  DANH_SACH_KH CSKH[]
}

model NGUON_KH {
  ID_NGUON String @id @map("_id")
  NGUON    String @unique

  DANH_SACH_KH CSKH[]
}

model NGUOI_GIOI_THIEU {
  ID_NGT          String @id @map("_id")
  TEN_NGT         String
  SO_DT_NGT       String

  DANH_SACH_KH_DUOC_GIOI_THIEU CSKH[]

  @@unique([TEN_NGT, SO_DT_NGT])
}

model LY_DO_TU_CHOI {
  ID_LY_DO String @id @map("_id")
  LY_DO    String @unique

  DANH_SACH_KH_TU_CHOI CSKH[]
}

model CSKH {
  ID_CSKH String @id @default(auto()) @map("_id") @db.ObjectId

  MA_KH          String   @unique
  ID_NHOM        String   @db.ObjectId
  ID_NGUON       String
  ID_NGT         String?
  ID_LY_DO_TC    String?
  NGAY_GHI_NHAN  DateTime
  TEN_KH         String
  TEN_VT         String?
  HINH_ANH       String?
  DIEN_THOAI     String
  EMAIL          String?
  MST            String?
  NGAY_THANH_LAP DateTime?
  DIA_CHI        String?
  SALES_PT       String?
  PHAN_LOAI      PHAN_LOAI_CSKH @default(CHUA_THAM_DINH)
  NV_CS          String?

  NHOM_KH          NHOM_KH            @relation(fields: [ID_NHOM], references: [ID_NHOM])
  NGUON_KH         NGUON_KH           @relation(fields: [ID_NGUON], references: [ID_NGUON])
  NGUOI_GIOI_THIEU NGUOI_GIOI_THIEU?  @relation(fields: [ID_NGT], references: [ID_NGT])
  LY_DO_TU_CHOI    LY_DO_TU_CHOI?     @relation(fields: [ID_LY_DO_TC], references: [ID_LY_DO])

  @@index([TEN_KH])
  @@index([DIEN_THOAI])
  @@index([NGAY_GHI_NHAN])
}
